{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plankton",
  "version": "0.2.0",
  "identifier": "com.openaquarium.plankton",
  "build": {
    "beforeDevCommand": "npm run prepare:engine && npm run dev",
    "beforeBuildCommand": "npm run prepare:engine && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["engines/keepassxc/**/*"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Plankton Approval Console",
        "width": 1440,
        "height": 840,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["plankton"]
      }
    }
  }
}
