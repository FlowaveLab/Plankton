{
  "name": "@plankton/desktop",
  "private": true,
  "description": "Desktop approval console for Plankton",
  "homepage": "https://github.com/FlowaveLab/Plankton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlowaveLab/Plankton.git"
  },
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "prepare:engine": "node scripts/prepare-keepassxc-engine.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/verify-entry-css.mjs",
    "test": "vitest run",
    "test:icons": "cargo test --manifest-path src-tauri/Cargo.toml --test icon_assets",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "chart.js": "^4.5.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.5",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.5",
    "shiki": "^4.4.3",
    "streamdown": "^2.5.0",
    "type-fest": "^5.8.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.27",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.9",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
